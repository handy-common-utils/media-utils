{
  "include": ["src/**/*"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "types": ["node"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "importHelpers": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true
  }
}
